{
  "manifest_version": 3,
  "minimum_chrome_version": "111",
  "name": "__MSG_appName__",
  "description": "__MSG_appDesc__",
  "default_locale": "en",
  "version": "4.0.5",
  "author": "HP",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "contextMenus",
    "clipboardWrite",
    "offscreen"
  ],
  "host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icons/toolbar-16.png",
      "32": "assets/icons/toolbar-32.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "https://accounts.google.com/*"
      ],
      "js": [
        "src/shared/asset-shell.js",
        "src/shared/builtin-rules.js",
        "src/shared/overlay-locales.js",
        "src/content/content-common.js",
        "src/content/content-ui-state.js",
        "src/content/content-tooltip-ui.js",
        "src/content/content-streaming.js",
        "src/content/content-embed-host.js",
        "src/content/content-scan.js",
        "src/content/content-metadata.js",
        "src/content/content-rules.js",
        "src/content/content-progate.js",
        "src/content/content-toast.js",
        "src/content/content-settings.js",
        "src/content/video-frame-picker.js",
        "src/content/content-surface-launchers.js",
        "src/content/content-history.js",
        "src/content/content-fab-drag.js",
        "src/content/content-overlay-image.js",
        "src/content/content-context-menu.js",
        "src/content/content-assistant-anim.js",
        "src/content/content-hover-style.js",
        "src/content/content-hover-image.js",
        "src/content/content-assistant-container.js",
        "src/content/content.js"
      ],
      "css": [
        "assets/css/content.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "src/content/content-comfyui-main.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "src/content/content-comfyui-adapter.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://www.lovart.ai/*",
        "https://lovart.ai/*"
      ],
      "js": [
        "src/content/content-lovart-adapter.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "ISOLATED"
    }
  ],
  "options_page": "src/options/options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "assets/icons/*",
        "assets/css/*",
        "src/shared/locales/*",
        "src/content/content-embed-overlay.js",
        "src/embed/prompt.html",
        "src/embed/batch.html",
        "src/embed/video.html",
        "src/embed/history.html",
        "src/embed/reverse.html",
        "src/embed/result-toast.html",
        "src/embed/result-toast.css",
        "src/embed/result-toast.js",
        "src/embed/translation.html",
        "src/embed/settings.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
